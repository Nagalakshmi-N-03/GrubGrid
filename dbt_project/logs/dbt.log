            when 4  then 'Q2' when 5  then 'Q2' when 6  then 'Q2'
            when 7  then 'Q3' when 8  then 'Q3' when 9  then 'Q3'
            when 10 then 'Q4' when 11 then 'Q4' when 12 then 'Q4'
        end                                                 as fiscal_quarter

    from date_spine
)

select * from final
    );
  
  
